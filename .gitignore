# Ignore all dotfiles and dot-directories
.*
!.gitignore

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Build & distribution artifacts
build/
dist/
*.egg-info/
.eggs/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# OS / editor noise (redundant but explicit)
.DS_Store
Thumbs.db
